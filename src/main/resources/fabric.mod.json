{
	"schemaVersion": 1,
	"id": "entropy",
	"version": "${version}",
	"name": "Entropy",
	"description": "Entropy is a mod all about chaos! Basically it's just a dump mod for everything I personally wanted on my SMP.\n But hey now it's here for you! Also DO NOT come at me for re-using old assets from CSMP mods.",
	"authors": [
		"whatEclipse"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/entropy/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.entropy.Entropy"
		],
		"client": [
			"net.entropy.EntropyClient"
		],
		"fabric-datagen": [
          "net.entropy.registry.EntropyDataGenerator"
		]
	},
	"mixins": [
		"entropy.mixins.json",
		{
			"config": "entropy.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"recommends": {
		"combatamenities": "*"
	}
}